<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:cq="http://www.day.com/jcr/cq/1.0"
          xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          jcr:primaryType="cq:Page">
    <jcr:content jcr:primaryType="nt:unstructured"
                 jcr:title="EToolbox Rollout Manager - Task History"
                 sling:resourceType="granite/ui/components/shell/page"
                 sling:vanityPath="/etoolbox/rollout-manager/history">
        <head jcr:primaryType="nt:unstructured">
            <clientlibs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/includeclientlibs"
                categories="[cq.rolloutmanager.history]"/>
        </head>
        <title jcr:primaryType="nt:unstructured"
               sling:resourceType="granite/ui/components/coral/foundation/text"
               text="EToolbox Rollout Manager - Task History"/>
        <actions jcr:primaryType="nt:unstructured">
            <primary jcr:primaryType="nt:unstructured">
                <refresh
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/button"
                    granite:id="refresh"
                    granite:title="Refresh history"
                    icon="refresh"
                    text="Refresh"
                    variant="quiet"/>
            </primary>
        </actions>
        <content jcr:primaryType="nt:unstructured"
                 sling:resourceType="granite/ui/components/coral/foundation/container"
                 maximized="{Boolean}true">
            <items jcr:primaryType="nt:unstructured">
                <columns jcr:primaryType="nt:unstructured"
                         sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                         maximized="{Boolean}true">
                    <items jcr:primaryType="nt:unstructured">
                        <table
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/table"
                            granite:class="is-scrollable"
                            granite:id="history"
                            itemResourceType="etoolbox-rollout-manager/components/historyItem"
                            limit="{Long}40"
                            size="{Long}40"
                            skipEmptyRow="{Boolean}true"
                            src="${requestPathInfo.resourcePath}.html{?offset,limit}"
                            variant="list">
                            <columns jcr:primaryType="nt:unstructured">
                                <created
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Created at"
                                    fixedWidth="{Boolean}true"/>
                                <initiator
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Initiator"
                                    fixedWidth="{Boolean}true"/>
                                <started
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Started at"
                                    fixedWidth="{Boolean}true"/>
                                <finished
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Finished at"
                                    fixedWidth="{Boolean}true"/>
                                <source
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="From"/>
                                <target
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="To"/>
                                <status
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Status"
                                    alignment="center"/>
                            </columns>
                            <datasource
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="etoolbox-rollout-manager/components/historyDatasource"/>
                        </table>
                    </items>
                </columns>
            </items>
        </content>
    </jcr:content>
</jcr:root>
